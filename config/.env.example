# Rkmlnx Configuration Example
# Copy this file to .env and customize for your build environment

# Build Configuration
BUILD_JOBS=4
BUILD_VERBOSE=0
BUILD_CCACHE=1

# Kernel Configuration
KERNEL_VERSION=6.1
KERNEL_ARCH=x86_64
KERNEL_COMPRESSION=xz

# Bootloader Configuration
BOOTLOADER=grub2
UEFI_SUPPORT=1
BIOS_SUPPORT=1

# Desktop Environment
DESKTOP_ENV=gnome
# Options: gnome, kde, xfce, i3, minimal

# Features
SECURITY_HARDENING=1
DEBUG_SYMBOLS=0
STRIP_BINARIES=1

# Installation Target
INSTALL_PREFIX=/usr/local
SYSTEM_ROOT=/

# Optional Components
DEVEL_TOOLS=1
DOC_GENERATION=1
NETWORK_TOOLS=1
SECURITY_TOOLS=1
